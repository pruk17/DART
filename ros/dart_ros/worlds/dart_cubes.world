<?xml version="1.0"?>
<!-- DART test map: open ground + sparse cube obstacles on some spokes, plus a
     thin visual-only disk at each of the 7 delivery points (t1-t7). No walls, so
     every target is reachable. Robot spawns at the origin. -->
<sdf version="1.6">
  <world name="dart_cubes">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- ===== cube obstacles (sparse, on paths the robot is likely to take) ===== -->
    <model name="cube_a">              <!-- red  -->
      <static>true</static>
      <pose>1.2 0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.85 0.3 0.3 1</ambient><diffuse>0.85 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cube_b">              <!-- blue -->
      <static>true</static>
      <pose>-1.2 0.7 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.3 0.5 0.85 1</ambient><diffuse>0.3 0.5 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cube_c">              <!-- green -->
      <static>true</static>
      <pose>1.3 -0.9 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.75 0.4 1</ambient><diffuse>0.3 0.75 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cube_d">              <!-- purple -->
      <static>true</static>
      <pose>0.1 1.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.25 0.75 1</ambient><diffuse>0.6 0.25 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== delivery-point markers (visual only, no collision) ===== -->
    <!-- gold disk at each t1..t7 position; radius 0.30, 0.02 thick, on the ground -->
    <model name="pad_t1"><static>true</static><pose>2.4 1.6 0.01 0 0 0</pose><link name="link">
      <visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.95 0.80 0.15 1</ambient><diffuse>0.95 0.80 0.15 1</diffuse></material></visual></link></model>

    <model name="pad_t2"><static>true</static><pose>-2.6 1.4 0.01 0 0 0</pose><link name="link">
      <visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.95 0.80 0.15 1</ambient><diffuse>0.95 0.80 0.15 1</diffuse></material></visual></link></model>

    <model name="pad_t3"><static>true</static><pose>2.6 -1.6 0.01 0 0 0</pose><link name="link">
      <visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.95 0.80 0.15 1</ambient><diffuse>0.95 0.80 0.15 1</diffuse></material></visual></link></model>

    <model name="pad_t4"><static>true</static><pose>-2.4 -1.6 0.01 0 0 0</pose><link name="link">
      <visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.95 0.80 0.15 1</ambient><diffuse>0.95 0.80 0.15 1</diffuse></material></visual></link></model>

    <model name="pad_t5"><static>true</static><pose>0.2 3.1 0.01 0 0 0</pose><link name="link">
      <visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.95 0.80 0.15 1</ambient><diffuse>0.95 0.80 0.15 1</diffuse></material></visual></link></model>

    <model name="pad_t6"><static>true</static><pose>-0.3 -3.1 0.01 0 0 0</pose><link name="link">
      <visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.95 0.80 0.15 1</ambient><diffuse>0.95 0.80 0.15 1</diffuse></material></visual></link></model>

    <model name="pad_t7"><static>true</static><pose>3.4 0.1 0.01 0 0 0</pose><link name="link">
      <visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.95 0.80 0.15 1</ambient><diffuse>0.95 0.80 0.15 1</diffuse></material></visual></link></model>

  </world>
</sdf>
